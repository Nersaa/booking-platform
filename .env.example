# Local development configuration.
# Generate a filled .env with random secrets:  python scripts/init_env.py
# Values end up inside connection URLs, so keep them URL-safe (letters, digits, - and _).
# Never commit the real .env.

POSTGRES_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
BOOKING_DB_PASSWORD=change-me

RABBITMQ_USER=booking
RABBITMQ_PASSWORD=change-me

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

CATALOG_SECRET_KEY=change-me
CATALOG_DEBUG=false

# Shared between Booking and the payment provider mock.
PAYMENT_PROVIDER_API_KEY=change-me
PAYMENT_WEBHOOK_SECRET=change-me
